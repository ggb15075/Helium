#!/bin/sh
set -e

case "${1:-}" in
    remove|purge)
        if command -v uicache >/dev/null 2>&1; then
            uicache -u /Applications/Helium.app || uicache -a || true
        fi
        ;;
esac

if [ "${1:-}" = purge ]; then
    rm -f /var/lib/helium/hud.disabled
    rmdir /var/lib/helium 2>/dev/null || true
fi

exit 0
